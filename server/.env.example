# Server Port
PORT=5000

# Allowed Frontend Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,https://portfolio-sivabalakeerthick.web.app,https://portfolio-sivabalakeerthick.firebaseapp.com

# Admin Security Password (Never put real password in .example file)
ADMIN_PASSWORD=your_secure_admin_password_here

# JWT Secret for signing session tokens
JWT_SECRET=your_random_jwt_secret_key_here

# EmailJS Server Configuration (Add your real keys in Render Dashboard, NOT here)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_admin_template_id
EMAILJS_REPLY_TEMPLATE_ID=your_emailjs_reply_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
